{% extends 'base.html.twig' %}

{% block title %}Commander - Étape 1 : adresse{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/forms.css') }}">  
{% endblock %}

{% block body %}
<h1>Veuillez saisir votre adresse de livraison</h1>

{{ form_start(form) }}
    {{ form_row(form.fullname) }}
    {{ form_row(form.address) }}
    {{ form_row(form.city) }}
    {{ form_row(form.postcode) }}
{{ form_end(form) }}
<a href="{{ path('cart_index') }}" class="btn-checkout btn-checkout-secondary">← Retour au panier</a>
{% endblock %}
