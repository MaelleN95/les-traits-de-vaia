{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Boutique{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/products.css') }}">
{% endblock %}

{% block body %}
    <h1>{{ category.name }}</h1>

    {% if products is empty %}
        <p>Aucun produit dans cette catégorie.</p>
    {% else %}
        <div class="product-grid">
            {% for product in products %}
                <article class="product-card">
                    <a href="{{ path('shop_product', {slug: product.slug}) }}" class="product-title">
                        {% if product.image %}
                            <img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy">
                        {% endif %}
                        <h3>{{ product.name }}</h3>
                    </a>

                    <p class="price">{{ (product.price / 100) | number_format(2, ',', ' ') }} €</p>

                    <p>
                        <a class="btn" href="{{ path('cart_add', {id: product.id}) }}">Ajouter au panier</a>
                        <a class="btn-link" href="{{ path('shop_product', {slug: product.slug}) }}">Voir</a>
                    </p>
                </article>
            {% endfor %}
        </div>

        {% if total > limit %}
            {% include 'shop/_pagination.html.twig' with {
                page: page,
                limit: limit,
                total: total,
                path: 'shop_category',
                slug: category.slug
            } %}
        {% endif %}
    {% endif %}

    <div class="spacer-large">
        <div class="btn-secondary">
            <button onclick="history.back()" class="btn btn-secondary">
                ← Revenir en arrière
            </button>
        </div>
        <div class="btn-secondary">
            <a href="{{ path('shop_index') }}" class="btn btn-secondary">
                Revenir à l'accueil
            </a>
        </div>
    </div>
{% endblock %}
