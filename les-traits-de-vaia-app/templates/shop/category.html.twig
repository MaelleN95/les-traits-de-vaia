{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Boutique{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/products.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/pagination.css') }}">
{% endblock %}

{% block body %}
    <h1>{{ category.name }}</h1>

    {% if products is empty %}
        <p>Aucun produit dans cette catégorie.</p>
    {% else %}
        <div class="product-grid">
            {% for product in products %}
              {% include 'shop/_product_card.html.twig' with {product: product} %}
            {% endfor %}
        </div>

        {% if total > limit %}
            {% include 'shop/_pagination.html.twig' with {
                page: page,
                limit: limit,
                total: total,
                path: 'shop_category',
                slug: category.slug
            } %}
        {% endif %}
    {% endif %}

    <div class="spacer-large">
        <div class="btn-secondary">
            <button onclick="history.back()" class="btn btn-secondary">
                ← Revenir en arrière
            </button>
        </div>
        <div class="btn-secondary">
            <a href="{{ path('shop_index') }}" class="btn btn-secondary">
                Revenir à l'accueil
            </a>
        </div>
    </div>
{% endblock %}
