{% extends 'base.html.twig' %}
{% block title %}{{ product.name }} — Boutique{% endblock %}

{% block body %}
<article class="product-detail">
    <img src="{{ product.image }}" alt="{{ product.name }}">
    <h1>{{ product.name }}</h1>
    <p class="price">{{ (product.price / 100) | number_format(2, ',', ' ') }} €</p>
    <div class="description">{{ product.description|raw }}</div>

    <form method="post" action="{{ path('cart_add', {id: product.id}) }}">
        <label>Quantité
            <input type="number" name="qty" value="1" min="1" max="{{ product.stock }}">
        </label>
        <button type="submit">Ajouter au panier</button>
    </form>

    <p><a href="{{ path('shop_category', {slug: product.category.slug}) }}">{{ product.category.name }}</a></p>
</article>
{% endblock %}
